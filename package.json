{
  "name": "datascalr",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "pip install -r backend\\requirements.txt && cd frontend && npm install",
    "deploy": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d",
    "deploy:build": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "deploy:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "deploy:stop": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
